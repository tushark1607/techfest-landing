<script>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- starfield canvas ----------
  const canvas = document.getElementById('stars');
  const ctx = canvas.getContext('2d');
  let stars = [];
  function resize(){
    canvas.width = canvas.offsetWidth * devicePixelRatio;
    canvas.height = canvas.offsetHeight * devicePixelRatio;
  }
  function initStars(){
    const count = Math.min(160, Math.floor((canvas.width*canvas.height)/26000));
    stars = Array.from({length:count}, () => ({
      x: Math.random()*canvas.width,
      y: Math.random()*canvas.height,
      r: (Math.random()*1.4+0.3) * devicePixelRatio,
      speed: (Math.random()*0.15+0.02) * devicePixelRatio,
      phase: Math.random()*Math.PI*2,
      gold: Math.random() < 0.12
    }));
  }
  function tick(t){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    stars.forEach(s=>{
      const tw = 0.5 + 0.5*Math.sin(t/900 + s.phase);
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
      ctx.fillStyle = s.gold ? `rgba(233,197,131,${0.3+tw*0.5})` : `rgba(238,231,216,${0.15+tw*0.5})`;
      ctx.fill();
      if(!reduceMotion){ s.y -= s.speed; if(s.y < -4) s.y = canvas.height+4; }
    });
    requestAnimationFrame(tick);
  }
  resize(); initStars();
  window.addEventListener('resize', ()=>{ resize(); initStars(); });
  requestAnimationFrame(tick);

  // ---------- astrolabe tick marks ----------
  const ticksHost = document.getElementById('ticksA');
  const cx=400, cy=400, r1=345, r2=360;
  let ticks = '';
  for(let i=0;i<48;i++){
    const a = (i/48)*Math.PI*2;
    const x1 = cx + Math.cos(a)*r1, y1 = cy + Math.sin(a)*r1;
    const x2 = cx + Math.cos(a)*r2, y2 = cy + Math.sin(a)*r2;
    ticks += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"/>`;
  }
  ticksHost.innerHTML = ticks;

  // ---------- stat count-up (single reveal moment) ----------
  const stats = document.querySelectorAll('.stat-row .num');
  const targets = [1998, 3, 2];
  let counted = false;
  function animateCount(el, target, isYear){
    const dur = 1400, start = performance.now();
    function step(now){
      const p = Math.min(1, (now-start)/dur);
      const eased = 1 - Math.pow(1-p, 3);
      const val = Math.floor(eased*target);
      el.textContent = isYear ? val : (el.dataset.suffix ? val + el.dataset.suffix : val);
      if(p<1) requestAnimationFrame(step); else el.textContent = el.dataset.final;
    }
    requestAnimationFrame(step);
  }
  const finals = ['1998','3 days','2'];
  stats.forEach((el,i)=> el.dataset.final = finals[i]);
  const statSection = document.querySelector('.about');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting && !counted){
        counted = true;
        if(!reduceMotion){
          animateCount(stats[0], 1998, true);
          animateCount(stats[1], 3, false);
          animateCount(stats[2], 2, false);
        }
      }
    });
  }, {threshold:0.4});
  if(statSection) io.observe(statSection);

  // ---------- voices marquee content ----------
  const names1 = ["A. P. J. Abdul Kalam","S. Somanath, ISRO","Lars Rasmussen, Google Maps","Tarja Halonen","G. Satheesh Reddy, DRDO"];
  const names2 = ["Sophia, Humanoid Robot","Kathryn Lueders, NASA","Octavian Morariu, IOC","Masayasu Ishida","Suresh Prabhu"];
  function fillTrack(id, names){
    const host = document.getElementById(id);
    const build = () => names.map(n => `<span>${n}</span><span class="sep">&#10022;</span>`).join('');
    host.innerHTML = build() + build();
  }
  fillTrack('track1', names1);
  fillTrack('track2', names2);
})();
</script>
